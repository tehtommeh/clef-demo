# Filled from scripts/preflight.py on this host (RTX 3090 24GB, CC 8.6, driver
# 595 / CUDA 13.2) and from the model's config.json. Change knobs here, not in
# the compose file.
PROJECT_NAME=clef-flash-local
UID=1000
GID=1000

# --- model --------------------------------------------------------------
MODEL_REPO=Cloudflare/clef-flash
MODEL_DIR=/models/Cloudflare__clef-flash
SERVED_MODEL_NAME=clef-flash

# --- hardware -----------------------------------------------------------
# bf16 is the training dtype and CC 8.6 supports it natively.
DTYPE=bfloat16
GPU_COUNT=1
SHM_SIZE=8gb

# --- limits -------------------------------------------------------------
# Weights take ~18.6GB of the 3090's 24GB and no KV cache exists (single
# forward pass), so the remaining headroom goes to activations. These were
# chosen to stay inside it; see README "Memory" before raising them.
MAX_INPUT_TOKENS=16384
MAX_BATCH_TOKENS=8192
MAX_BATCH_SIZE=16
MAX_IMAGE_SIDE=1024
VIDEO_MAX_FRAMES=16
VIDEO_MAX_SIDE=448
VIDEO_FRAME_CAP=32

# --- ports --------------------------------------------------------------
API_PORT=8000
FRONTEND_PORT=7860
HEALTH_START_PERIOD=600s

# --- images -------------------------------------------------------------
API_BASE_IMAGE=pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime
